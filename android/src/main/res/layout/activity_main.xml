<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/filePathInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="filePath" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="endpoint"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/intervalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="interval (ms)"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/agentIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="agentId"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar AgentService"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parar AgentService"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
